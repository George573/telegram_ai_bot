TELEGRAM_BOT_TOKEN=
# Choose openai (default) or zai. Only the selected provider key is required.
MODEL_PROVIDER=openai
ZAI_API_KEY=
ZAI_MODEL=glm-4.7
# Multimodal photo model; voice uses glm-asr-2512 (30 seconds maximum).
ZAI_VISION_MODEL=glm-4.6v
# Standard OpenAI API key: API usage is billed separately from ChatGPT.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ALLOWED_CHAT_IDS=
# Comma-separated Telegram user IDs allowed to manage settings in approved groups.
BOT_SUPERADMIN_IDS=
# Different passwords for database admin and limited application role.
POSTGRES_PASSWORD=
BOT_DB_PASSWORD=
HISTORY_MAX_MESSAGES=50
SUMMARY_MAX_CHARS=4000
# Lifetime allowance enforced by the bot, shared across chats and restarts.
BOT_BUDGET_USD=10
REPLY_COOLDOWN_SECONDS=10
# Minimum gap after any AI request finishes, before the next starts (0..30).
API_MIN_INTERVAL_SECONDS=0.25

# Photos and voice are processed in memory, bounded before upload.
MEDIA_MAX_BYTES=5242880
VOICE_MAX_SECONDS=120
