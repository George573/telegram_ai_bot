# Only application/build inputs enter the daemon's build context.
# Re-include individual file globs, never whole directories.
**
!Dockerfile
!Dockerfile.db
!Dockerfile.test
!requirements.lock
!src/*.py
!src/licenses/*.txt
!src/skills/*/SKILL.md
!scripts/*.sh
!scripts/*.sql
!scripts/discover_chat.py
!tests/*.py
!tests/browser/*.py
!tools/Dockerfile
!tools/requirements.lock
!tools/*.py
# Secrets and caches stay out even inside allowed folders.
**/.env
**/.env.*
**/credentials
**/credentials.*
**/__pycache__
**/*.pyc
